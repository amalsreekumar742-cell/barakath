# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
.next/
out/
lib/**/*.js
functions/lib/

# Turborepo
.turbo/

# TypeScript incremental build cache
*.tsbuildinfo

# Env files (keep the *.example templates committed)
.env
.env.*
# `!.env.example` alone did NOT cover `.env.e2e.example`, so the E2E templates were silently ignored
# and a fresh clone had no idea which variables the test suites need. Match every example variant.
!.env*.example

# Playwright output. These are regenerated by every run and are pure noise in a diff — a single
# `--list` was enough to show up as two dozen deleted files.
# NOTE: apps/admin/playwright-report/ is already TRACKED from before this rule existed; it stays in
# history until someone runs `git rm -r --cached apps/admin/playwright-report`.
test-results/
playwright-report/
blob-report/
.playwright/

# Firebase
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log

# Flutter / Dart
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
apps/app/build/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
Thumbs.db

