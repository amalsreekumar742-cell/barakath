{
  "name": "@barakath/shared",
  "version": "1.0.0",
  "private": true,
  "description": "Framework-agnostic TypeScript shared library for Barakath (domain types, Firestore collection names, enums, pure utils).",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./config/collections": "./src/config/collections.ts",
    "./config/enums": "./src/config/enums.ts",
    "./types": "./src/types/index.ts",
    "./utils/keywordsBuilder": "./src/utils/keywordsBuilder.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "echo \"no tests yet\" && exit 0"
  },
  "peerDependencies": {
    "firebase": "^11.0.0"
  },
  "devDependencies": {
    "firebase": "^11.1.0",
    "typescript": "^5.6.3"
  }
}
