# Barakath Cloud Functions — parameter template.
# Copy to functions/.env and fill in real values. functions/.env is NEVER committed.
# Razorpay keys are NOT here — they are read at runtime from the Firestore `general/config`
# document (written by the admin Settings → Payment Gateway screen).

# Phone-OTP login uses the MSG91 **OTP Widget** flow (widgetId + tokenAuth), driven server-side.
# It needs NO approved template_id.

# MSG91 account auth key. SERVER-ONLY secret. From the MSG91 dashboard.
MSG91_AUTH_KEY=""
# MSG91 OTP Widget id — Dashboard → OTP Widget → your widget. This is the CUSTOMER APP widget.
MSG91_WIDGET_ID=""
# MSG91 widget token auth. SERVER-ONLY secret. Issued alongside the widget id.
MSG91_TOKEN_AUTH=""

# WEBSITE OTP widget — the site uses a SEPARATE MSG91 widget with a different id. The callable picks
# it when the caller sends `source: 'web'`. Leave blank to fall back to the app widget above.
MSG91_WIDGET_ID_WEB=""
# Website widget token auth. Optional — leave blank if the account shares one token across widgets;
# the callable falls back to MSG91_TOKEN_AUTH.
MSG91_TOKEN_AUTH_WEB=""
