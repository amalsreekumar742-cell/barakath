# Barakath App — placeholder for Firebase / third-party config values.
#
# NOTE: Flutter apps normally take Firebase config from the generated `firebase_options.dart`
# (via `flutterfire configure`), NOT from a .env file. This template is for any additional
# runtime config you choose to load (e.g. via flutter_dotenv). Never commit real secrets;
# server-only secrets (Razorpay key secret, MSG91 auth key) belong on the server, never in the app.

FIREBASE_PROJECT_ID=
FIREBASE_API_KEY_ANDROID=
FIREBASE_API_KEY_IOS=
FIREBASE_APP_ID_ANDROID=
FIREBASE_APP_ID_IOS=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_STORAGE_BUCKET=

# Razorpay (publishable key id only — the secret stays server-side)
RAZORPAY_KEY_ID=

# Google Maps
GOOGLE_MAPS_API_KEY_ANDROID=
GOOGLE_MAPS_API_KEY_IOS=
