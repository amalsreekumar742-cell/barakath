	<true/>
	<key>NSCameraUsageDescription</key>
	<string>Barakath uses the camera to take a photo for your profile, a product review or a return request.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Barakath uses your location to fill in your delivery address.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Barakath needs access to your photos to add a picture to your profile, a product review or a return request.</string>
