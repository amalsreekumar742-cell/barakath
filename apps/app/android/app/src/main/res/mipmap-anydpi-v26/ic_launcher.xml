<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon (API 26+). The launcher supplies the mask — circle, squircle,
  rounded square, whatever the OEM ships — so the icon MUST be handed over as a
  separate background and foreground rather than a pre-masked bitmap. Without
  this file Android falls back to mipmap/ic_launcher.png and letterboxes it
  inside a white blob.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
