# Barakath Website — Firebase web config (public, ships to the browser).
# Copy to `.env` and fill with your Firebase project values. Never commit `.env`.
# These are the ONLY client-exposed values — server secrets (Razorpay secret, MSG91 key,
# Firebase Admin credentials) belong in Cloud Functions / App Hosting env, never here.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# The site's public origin, e.g. https://barakath.com — no trailing slash.
# REQUIRED IN PRODUCTION. Without it: sitemap.xml renders empty (a sitemap of relative URLs is
# invalid and every crawler rejects it), robots.txt omits the sitemap line, and Open Graph images
# stay relative, which strips the preview image from WhatsApp and Twitter shares. The build still
# succeeds without it, so this degrades quietly — set it before going live.
NEXT_PUBLIC_SITE_URL=

# Razorpay PUBLISHABLE key id for the checkout widget. Publishable by design — it identifies the
# merchant and cannot move money on its own. The key SECRET must never appear here or in any
# NEXT_PUBLIC_ variable; it lives in Cloud Functions (general/secrets, admin-read-only).
# The storefront can also read this from general/config.payment.razorpayKeyId; this var is the
# override for a test key during local development.
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Google Maps JS API key for the address picker (spec 3.17). Client-exposed by necessity —
# restrict it by HTTP referrer in the Google Cloud console rather than trying to hide it.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
