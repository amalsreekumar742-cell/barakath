# Storefront E2E configuration. Copy to `.env.e2e` and fill in.
# `.env.e2e` is git-ignored — never commit real values. See e2e/README.md.

# Where the suite points. Defaults to the local dev server.
E2E_BASE_URL=http://localhost:3000

# --- Signed-in flows ---------------------------------------------------------
# Path to an Admin SDK service-account JSON, saved OUTSIDE this repository.
# Firebase Console -> Project settings -> Service accounts -> Generate new private key.
#
# Required for every signed-in spec and for the notification fan-out check: signing a customer in
# means minting a Firebase custom token, which only the Admin SDK can do (production gets one from
# the verifyOTP function after an SMS, which a test runner cannot receive).
#
# This key bypasses all Security Rules. Treat it like a password and revoke it if it leaks.
# Without it those specs SKIP with an explicit reason — they do not fail, and they do not pass.
E2E_SERVICE_ACCOUNT=

# The shared test customer. Must stay in a range not allocated to real subscribers.
E2E_CUSTOMER_PHONE=+919999900001
