# Barakath Admin — Firebase web config (public, ships to the browser).
# Copy to `.env` and fill with your Firebase project values. Never commit `.env`.
# These are the ONLY client-exposed values — server secrets (Razorpay secret, MSG91 key,
# Firebase Admin credentials) belong in Cloud Functions env, never here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
