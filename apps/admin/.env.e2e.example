# Test credentials for the authenticated Playwright suite (apps/admin/e2e/admin.spec.ts).
# Copy this file to `.env.e2e`, fill in a REAL admin account for the barakath-e6ad3 project, then run:
#   pnpm test:e2e:ui        (watch live, interactive)
#   pnpm test:e2e:headed    (watch the real browser)
#   pnpm test:e2e           (headless)
# NEVER commit real credentials. Keep .env.e2e out of version control.
E2E_ADMIN_EMAIL=REPLACE_WITH_ADMIN_EMAIL
E2E_ADMIN_PASSWORD=REPLACE_WITH_ADMIN_PASSWORD
