rules_version = '2';

// Barakath Cloud Storage Security Rules.
// Catalogue images (category/product/banner) are publicly readable so storefronts can display them,
// and writable only by admins (a subAdmins doc exists for the caller). Tighten per-path as more upload
// features ship. NOTE: requires Firebase Storage to be provisioned for the project.
service firebase.storage {
  match /b/{bucket}/o {

    // Whether the caller is an admin — via the `admin: true` custom claim on their ID token.
    // WHY the claim (not a cross-service Firestore read): Storage→Firestore rule reads are unreliable
    //   here (denied on this plan), and a custom claim is the standard, cheap gate. The claim is set
    //   by the Sub Admin Cloud Function (spec §1.20) when an admin is provisioned.
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Catalogue images (categories §1.4, product variants §1.5): public read; admin write.
    // WHY size/type guards in the rule too: defence-in-depth over the client-side 2MB/type check
    //   (spec §1.22 image validation) — the server rejects oversized/non-image uploads regardless.
    function validImage() {
      return request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /categories/{categoryId}/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && validImage();
    }

    // products/{productId}/variants/{variantId}/{index}
    match /products/{productId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && validImage();
    }

    // banners/{bannerId}/image (spec §1.15): public read; admin write.
    match /banners/{bannerId}/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && validImage();
    }

    // notifications/{notificationId}/image (spec §1.18): public read (app/website render the push
    // image); admin write.
    match /notifications/{notificationId}/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && validImage();
    }

    // Profile photos: `users/{uid}/profile` (overrides spec §4.22's
    // `customers/{customerId}/profile` so Storage matches the Firestore
    // collection, which is `users`).
    //
    // WHY this rule had to exist: the app has always written to this path, but
    // no rule matched it, so it fell through to the catch-all deny below and
    // every profile-photo upload failed in production.
    //
    // Public read: the URL is stored on the user doc and rendered by the app,
    // the website and the admin panel — same posture as the other image types.
    // Write is the owner only, so nobody can overwrite another person's avatar.
    match /users/{uid}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && validImage();
    }

    // Review photos (spec §2.24, §4.22): public read (they render on the product
    // page); any signed-in customer may upload. The review document itself is
    // gated by Firestore rules — Storage only guards the bytes.
    match /reviews/{reviewId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && validImage();
    }

    // Replacement request photos (spec §2.18, §4.22): evidence photos of a
    // customer's damaged goods. Not public.
    //
    // WHY read is signed-in rather than admin-only: the uploader must call
    // getDownloadURL() to store the link on the request document, and that call
    // is a READ. An admin-only rule made every replacement submission fail after
    // the bytes had already landed.
    //
    // WHY this is acceptable: `requestId` is a 20-character Firestore auto-id,
    // so the path is not enumerable, and nothing here is more sensitive than the
    // photo of a damaged product. It is NOT public, so a link cannot be opened
    // by an anonymous visitor.
    //
    // The airtight version is to key the path on the uid
    // (`replacements/{uid}/{requestId}/{index}`) and scope read+write to the
    // owner. That is a path change across StoragePaths and the datasource — take
    // it if these photos ever carry anything more private.
    match /replacements/{requestId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && validImage();
    }

    // Everything else denied until its feature ships.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
